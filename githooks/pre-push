#!/bin/bash
# pre-push gate (2026-07-19, tracked+wired via core.hooksPath 2026-07-20): a
# push to origin IS a production deploy (GitHub Pages serves
# sign.legacyvpartners.com from this repo). Most test/ harnesses are
# deliberately untracked (test/* gitignored, a handful un-ignored by name)
# so the bulk of the rig never ships on the LP domain, which means this
# hook is the ONLY automated gate between an edit and live LP-facing forms
# for most of the checks below -- no CI can run what it can't see.
#
# This script itself now lives here (githooks/pre-push, tracked) instead of
# only in .git/hooks/pre-push (never version-controlled, local to one
# clone). Wire it up after a fresh clone with:
#   git config core.hooksPath githooks
# `pnpm install` doesn't apply here (no package.json / build step on this
# static site), so unlike legacy-tools-mono this can't self-wire on
# install; run the config command by hand once per clone.
#
# israel-flow.cjs and console-harness.cjs (both invoked below) ARE tracked
# (test/*  gitignored, both individually un-ignored by name), so a fresh
# clone with core.hooksPath wired gets a working gate with no manual test/
# restore step. (This comment previously claimed the opposite - stale as
# of 2026-08-02; test/rig.cjs and several new harnesses had the same
# gitignore-allowlist gap, since fixed.)
#
# Bypass (emergencies only): git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
if [ ! -d test ]; then
  echo "pre-push: test/ harnesses not present on this machine; refusing to deploy unverified. (git push --no-verify to override)"
  exit 1
fi
echo "pre-push: running deploy gate harnesses..."
node test/coupling-check.cjs
node test/client-honesty-harness.cjs  >/dev/null && echo "client-honesty OK"
node test/index-honesty-harness.cjs   >/dev/null && echo "index-honesty OK"
node test/snap-ttl-harness.cjs        >/dev/null && echo "snap-ttl OK"
node test/israel-flow.cjs             >/dev/null && echo "israel-flow OK"
node test/console-harness.cjs         >/dev/null && echo "console-harness OK"
node test/lvp-token-consistency.cjs   >/dev/null && echo "lvp-token-consistency OK"
node test/atrium-palette-sync.cjs     >/dev/null && echo "atrium-palette-sync OK"
# CTO review remediation (2026-08-02): real extraction-based tests for the
# fixes shipped this pass, added to the gate as they were written rather
# than left sitting unused in test/.
node test/upload-race-harness.cjs        >/dev/null && echo "upload-race OK"
node test/doc-sanitize-harness.cjs       >/dev/null && echo "doc-sanitize OK"
node test/id-checksum-harness.cjs        >/dev/null && echo "id-checksum OK"
node test/signer-config-retry-harness.cjs >/dev/null && echo "signer-config-retry OK"
node test/flow-double-submit-harness.cjs >/dev/null && echo "flow-double-submit OK"
node test/resume-jump-harness.cjs        >/dev/null && echo "resume-jump OK"
node test/signer-vocab-harness.cjs       >/dev/null && echo "signer-vocab OK"
node test/attribute-escaping-harness.cjs >/dev/null && echo "attribute-escaping OK"
# Converted from exploratory console.log probes to real assertions
# (2026-08-02, CTO review finding #12) - these walk index.html end to end
# (drive-branch.cjs alone runs both applicant lanes through every page), so
# they take longer than the other harnesses above but they are this repo's
# only automated coverage of the actual multi-page conditional-reveal /
# required-field / submit-gating behavior an LP experiences.
node test/select-default-probe.cjs >/dev/null && echo "select-default OK"
node test/joint-probe.cjs          >/dev/null && echo "joint OK"
node test/conditional-probe.cjs    >/dev/null && echo "conditional OK"
node test/drive-branch.cjs         >/dev/null && echo "drive-branch OK"
node test/email-amount-probe.cjs   >/dev/null && echo "email-amount OK"
node test/test-adversarial.cjs     >/dev/null && echo "test-adversarial OK"
node test/test-positive-submit.cjs >/dev/null && echo "test-positive-submit OK"
# New coverage for previously-untested areas (2026-08-02, CTO review finding
# #13): SWIFT/BIC format validation + the 10MB upload cap, and prefill-based
# resume restoration + the FATCA/CRS conditional reveal.
node test/format-and-upload-cap-harness.cjs     >/dev/null && echo "format-and-upload-cap OK"
node test/resume-restore-and-fatca-harness.cjs  >/dev/null && echo "resume-restore-and-fatca OK"
# Fresh /cto-review pass (2026-08-02) on the already-shipped state: two real
# security findings (console attribute-escaping gap, index.html CSS
# injection), a reliability gap (index.html's config bootstrap had no
# retry, unlike its three sibling forms), a popstate multi-step-jump bug in
# index.html/israel.html, and a UX regression in signer.html's own
# earlier-this-session retry fix (the pre-fetch Hebrew call was silently
# defeated by the lane gate). Also: drawer-race-harness.cjs and
# console-action-contract.cjs existed, passed, and caught real bug classes
# but were never wired into this gate.
node test/security-review-fixes-harness.cjs      >/dev/null && echo "security-review-fixes OK"
node test/index-config-retry-harness.cjs         >/dev/null && echo "index-config-retry OK"
node test/popstate-navigation-harness.cjs        >/dev/null && echo "popstate-navigation OK"
node test/signer-lane-gate-bypass-harness.cjs    >/dev/null && echo "signer-lane-gate-bypass OK"
node test/drawer-race-harness.cjs                >/dev/null && echo "drawer-race OK"
node test/console-action-contract.cjs            >/dev/null && echo "console-action-contract OK"
node test/board-search-lp-directory-harness.cjs  >/dev/null && echo "board-search-lp-directory OK"
# Phase 4 pilot flip (2026-08-05): israel.html's in-flight-session legacy-
# gateway fallback (old-token boots retry the pre-flip GAS deployment and
# stick; fresh sessions and primary outages never reroute).
node test/pilot-fallback-harness.cjs             >/dev/null && echo "pilot-fallback OK"
echo "pre-push: all green - deploying to Pages."
