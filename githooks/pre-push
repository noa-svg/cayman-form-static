#!/bin/bash
# pre-push gate (2026-07-19, tracked+wired via core.hooksPath 2026-07-20): a
# push to origin IS a production deploy (GitHub Pages serves
# sign.legacyvpartners.com from this repo). Most test/ harnesses are
# deliberately untracked (test/* gitignored, a handful un-ignored by name)
# so the bulk of the rig never ships on the LP domain, which means this
# hook is the ONLY automated gate between an edit and live LP-facing forms
# for most of the checks below -- no CI can run what it can't see.
#
# This script itself now lives here (githooks/pre-push, tracked) instead of
# only in .git/hooks/pre-push (never version-controlled, local to one
# clone). Wire it up after a fresh clone with:
#   git config core.hooksPath githooks
# `pnpm install` doesn't apply here (no package.json / build step on this
# static site), so unlike legacy-tools-mono this can't self-wire on
# install; run the config command by hand once per clone.
#
# israel-flow.cjs and console-harness.cjs (both invoked below) ARE tracked
# (test/*  gitignored, both individually un-ignored by name), so a fresh
# clone with core.hooksPath wired gets a working gate with no manual test/
# restore step. (This comment previously claimed the opposite - stale as
# of 2026-08-02; test/rig.cjs and several new harnesses had the same
# gitignore-allowlist gap, since fixed.)
#
# Bypass (emergencies only): git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
if [ ! -d test ]; then
  echo "pre-push: test/ harnesses not present on this machine; refusing to deploy unverified. (git push --no-verify to override)"
  exit 1
fi
# 2026-08-07: preflight the test deps instead of letting 30+ harnesses each
# crash with MODULE_NOT_FOUND. Same fail-closed outcome, one clear message.
# (Historical note, same date: the pre-2026-08-06 sequential hook ran each
# harness as `node test/x.cjs >/dev/null && echo "x OK"` under set -e, and
# bash errexit does NOT fire when the failing command is a non-final member
# of a && list -- so every harness except the bare coupling-check line could
# fail without blocking the push. The parallel runner below closed that hole
# structurally; never reintroduce per-line `&& echo OK` harness invocations.)
if [ ! -d test/node_modules/jsdom ]; then
  echo "pre-push: test/node_modules/jsdom missing - the jsdom harnesses cannot run."
  echo "Fix: npm install --prefix test    (then push again)"
  echo "Refusing to deploy unverified. (git push --no-verify to override, emergencies only)"
  exit 1
fi
echo "pre-push: running deploy gate harnesses..."

# 2026-08-06: these used to run STRICTLY SEQUENTIALLY and the gate exceeded ten
# minutes, so during a live LP lockout that day it was bypassed with --no-verify
# three times running. A deploy gate that cannot finish under pressure is a
# deploy gate that gets skipped exactly when it matters most, which is worse
# than a slower one that gets run.
#
# Measured on this repo: most harnesses are 0.3-3s, but israel-flow,
# client-honesty-harness and index-honesty-harness each exceed 75s (they boot
# the real multi-page forms in jsdom). Sequentially the gate costs the SUM;
# concurrently it costs the SLOWEST. Same harnesses, same order in the list
# below, nothing dropped - only the scheduling changed.
#
# Concurrency is capped rather than unbounded: 34 simultaneous jsdom processes
# thrash a laptop and would make the gate slower, not faster.
# Concurrency 4, NOT core count. The first cut used hw.ncpu and six harnesses
# died with EMPTY logs - not assertion failures, kills: each jsdom rig parses a
# ~100KB+ form and a dozen at once exhausts memory on a laptop. All six pass
# individually. A gate that invents failures gets distrusted and then bypassed,
# which is the same end state as one that is too slow. 4 is enough to overlap
# the three genuinely slow harnesses (israel-flow, client-honesty,
# index-honesty), which are what dominate wall-clock anyway.
JOBS="${PREPUSH_JOBS:-4}"
OUT="$(mktemp -d)"
trap 'rm -rf "$OUT"' EXIT

HARNESSES=(
  coupling-check
  client-honesty-harness
  index-honesty-harness
  snap-ttl-harness
  israel-flow
  beneficiary-declaration-harness
  console-harness
  lvp-token-consistency
  atrium-palette-sync
  upload-race-harness
  doc-sanitize-harness
  id-checksum-harness
  signer-config-retry-harness
  flow-double-submit-harness
  required-note-harness
  resume-jump-harness
  signer-vocab-harness
  attribute-escaping-harness
  select-default-probe
  joint-probe
  conditional-probe
  drive-branch
  email-amount-probe
  test-adversarial
  test-positive-submit
  format-and-upload-cap-harness
  resume-restore-and-fatca-harness
  security-review-fixes-harness
  index-config-retry-harness
  popstate-navigation-harness
  signer-lane-gate-bypass-harness
  drawer-race-harness
  console-action-contract
  console-recovery-contract
  board-search-lp-directory-harness
  pilot-fallback-harness
  signer-sticky-token-key-harness
  flow-account-normalise-harness
  flow-cayman-lane-harness
  signer-doc-gate-harness
  israel-sigpad-encode-harness
  israel-english-address-fallback-harness
  israel-cp-english-address-fatca-gate
)

# `set -e` is deliberately relaxed for the fan-out: we want EVERY failure
# reported in one pass, not just the first. The explicit exit below restores
# fail-closed behaviour.
set +e
# OUT is exported, NOT interpolated into the -c string: interpolating it made
# the assembled command line long enough that BSD xargs refused with "command
# line cannot be assembled, too long", ran NOTHING, and the gate then printed
# "all green" in 5 seconds. A gate that passes without running is the worst
# possible failure mode, so the runner is kept deliberately tiny and the
# all-green line below is guarded by the ran-count check.
export OUT
printf '%s\n' "${HARNESSES[@]}" | xargs -P "$JOBS" -I{} bash -c '
  if node "test/$1.cjs" > "$OUT/$1.log" 2>&1; then echo "  OK   $1"; else touch "$OUT/$1.failed"; echo "  FAIL $1"; fi
' _ {}
set -e

# RAN-COUNT GUARD. The 2026-08-06 first cut of this parallel gate reported
# "all green" having executed zero harnesses, because xargs bailed before
# starting any. Never trust an absence of failures as evidence of success:
# assert that every harness actually produced a log.
RAN=$(ls "$OUT"/*.log 2>/dev/null | wc -l | tr -d ' ')
EXPECTED=${#HARNESSES[@]}
if [ "$RAN" != "$EXPECTED" ]; then
  echo ""
  echo "pre-push: only $RAN of $EXPECTED harnesses actually RAN - the runner itself failed."
  echo "Refusing to deploy on an unproven gate. (git push --no-verify overrides, emergencies only)"
  exit 1
fi
FAILED=$(ls "$OUT"/*.failed 2>/dev/null | wc -l | tr -d ' ')
if [ "$FAILED" != "0" ]; then
  echo ""
  echo "pre-push: $FAILED harness(es) FAILED - refusing to deploy. Output follows:"
  for f in "$OUT"/*.failed; do
    n=$(basename "$f" .failed)
    echo ""
    echo "----- $n -----"
    cat "$OUT/$n.log"
  done
  echo ""
  echo "(git push --no-verify overrides, emergencies only)"
  exit 1
fi
echo "pre-push: all green - deploying to Pages."
